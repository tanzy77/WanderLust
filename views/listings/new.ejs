<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
  <form method="POST" action="/listings">
    <div class="col-8 offset-2">
      <h2>Create New List</h2>
      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" placeholder="Enter title" name="listing[title]" class="form-control">
      </div>
      <div class="mb-3">
        <label for="title" class="form-label">Description</label>
        <textarea placeholder="Description" name="listing[description]" class="form-control"></textarea>
      </div>
      <div class="mb-3">
        <label for="title" class="form-label">Image URL</label>
        <input type="url" placeholder="Image URL" name="listing[image][url]" class="form-control"> 
      </div>
      <div class="row">
        <div class="mb-3 md:col-4">
          <label for="title" class="form-label">Price</label>
          <input type="number" placeholder="Price" name="listing[price]" class="form-control">
        </div>
        <div class="mb-3 md:col-8">
          <label for="title" class="form-label">Location</label>
          <input type="text" placeholder="location" name="listing[location]" class="form-control">
        </div>
      </div>
      <div class="mb-3">
        <label for="title" class="form-label">Country</label>
        <input type="text" placeholder="Country" name="listing[country]" class="form-control">
      </div>
      <br>
      <button class="btn btn-dark mt-3">Add</button>
      <br><br>
    </div>  
  </form>
</div>  
