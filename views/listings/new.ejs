<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
</head>
<body>
  <h2>Create</h2>
  <form method="POST" action="/listings">
    <input type="text" placeholder="Enter title" name="listing[title]">
    <br>
    <br>
    <textarea placeholder="description" name="listing[description]"></textarea>
    <br>
    <br>
    <input type="url" placeholder="Image URL" name="listing[image][url]">    
    <br>
    <br>
    <input type="number" placeholder="Price" name="listing[price]">
    <br>
    <br>
    <input type="text" placeholder="location" name="listing[location]">
    <br>
    <br>
    <input type="text" placeholder="Country" name="listing[country]">
    <br>
    <br>
    <button>Submit</button>
  </form>
</body>
</html>